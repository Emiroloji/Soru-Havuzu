<?xml version="1.0" encoding="utf-8"?>
<!--
  Varsayılan: yalnızca HTTPS. Şimdilik domain ve sertifika olmadığı için sadece
  Dokploy'un verdiği sslip.io adresine ve emülatörden bilgisayara (10.0.2.2) HTTP izni var.
  Domain + HTTPS'e geçince domain-config bloğu silinmeli.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">sslip.io</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
