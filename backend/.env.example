# Dokploy Postgres servisinin "Internal Connection URL" değeri (canlıda)
# ya da SSH tüneli / yerel docker ile dev veritabanı:
DATABASE_URL=postgresql://soru:soru@localhost:5432/soruhavuzu_dev
DATABASE_POOL_SIZE=5
# Oturum token'larını imzalar; en az 32 karakter. Üretmek için: openssl rand -hex 32
# Değiştirilirse herkesin oturumu düşer.
JWT_SECRET=yerel-gelistirme-anahtari-en-az-32-karakter-olmali
PORT=8080
UPLOAD_DIR=./uploads
